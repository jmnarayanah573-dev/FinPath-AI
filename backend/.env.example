# ============================================================
# FinPath AI Backend — Environment Variables (.env.example)
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# Add  .env  to your .gitignore immediately if not already done.
# ============================================================

HOST=127.0.0.1
PORT=8000

# JWT signing key — generate a strong random string for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET>

# ============================================================
# Supabase PostgreSQL — Direct Connection (REQUIRED)
# ============================================================
# Where to find this:
#   1. Open your Supabase project dashboard: https://supabase.com/dashboard
#   2. Go to: Settings → Database → Connection string → URI
#   3. Copy the "Direct connection" URI (NOT the "Transaction pooler" URI).
#      The direct connection URI looks like:
#        postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#   4. Replace <PASSWORD> with your actual database password.
#
# IMPORTANT — do NOT use the Transaction pooler (port 6543) for this app.
SUPABASE_DB_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

# ============================================================
# Supabase REST API (optional — for future use with supabase-py)
# ============================================================
# Go to: Settings → API → Project URL and API Keys
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
# Use the "service_role" key ONLY in backend code; NEVER expose it to the browser.
SUPABASE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ============================================================
# LLM API Keys (optional — for Copilot AI responses)
# ============================================================
GEMINI_API_KEY=<YOUR_GOOGLE_GEMINI_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# ============================================================
# File Storage
# ============================================================
# Local directory for uploaded documents (relative to backend/)
UPLOAD_DIR=uploads
# NOTE: Uploaded files are stored locally. If you deploy to a cloud service,
# consider migrating file storage to Supabase Storage or an S3-compatible bucket.
