# FinPath AI Environment Configuration Example
# Copy this file to .env and fill in real values if available.
# The application runs smoothly out of the box with zero external configuration!

# Server Configuration
HOST=127.0.0.1
PORT=8000
JWT_SECRET=finpath-super-secret-production-grade-key-2026

# Database Configuration (Optional Supabase)
# If left empty, FinPath AI automatically uses local SQLite with full relational schemas & seed data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# AI / LLM Integration (Optional)
# If provided, FinPath routes queries through the live LLM API.
# If omitted, FinPath seamlessly uses its built-in expert financial rules and knowledge engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local File Storage
UPLOAD_DIR=uploads
