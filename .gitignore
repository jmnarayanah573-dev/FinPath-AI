# ============================================================
# FinPath AI — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
*.env.local
*.env.production
*.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
venv/
.venv/
env/
ENV/

# --- SQLite local databases ---
*.db
*.sqlite
*.sqlite3

# --- Uploads / user files ---
backend/uploads/
uploads/

# --- IDE & OS ---
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Test artifacts ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Node (if frontend uses npm) ---
node_modules/
frontend/.next/
frontend/dist/
frontend/build/
